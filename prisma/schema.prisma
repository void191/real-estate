generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  buyer
  agent
  admin
}

enum ListingStatus {
  available
  under_offer
  sold
}

enum ViewingStatus {
  requested
  accepted
  declined
  en_route
  arrived
  completed
  cancelled
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password_hash String
  role          Role      @default(buyer)
  phone         String?
  avatar_url    String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  listings        Listing[]  @relation("AgentListings")
  buyer_viewings  Viewing[]  @relation("BuyerViewings")
  agent_viewings  Viewing[]  @relation("AgentViewings")
  favorites       Favorite[]

  @@map("users")
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  address     String
  latitude    Float
  longitude   Float
  price       Int
  bedrooms    Int
  bathrooms   Float
  area_sqm    Int
  description String        @db.Text
  photos      String[]
  status      ListingStatus @default(available)
  agent_id    String
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  agent     User       @relation("AgentListings", fields: [agent_id], references: [id])
  favorites Favorite[]
  viewings  Viewing[]

  @@map("listings")
}

model Favorite {
  id         String   @id @default(cuid())
  buyer_id   String
  listing_id String
  created_at DateTime @default(now())

  buyer   User    @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@unique([buyer_id, listing_id])
  @@map("favorites")
}

model Viewing {
  id             String        @id @default(cuid())
  listing_id     String
  buyer_id       String
  agent_id       String
  requested_time DateTime
  status         ViewingStatus @default(requested)
  notes          String?       @db.Text
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  listing       Listing        @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer         User           @relation("BuyerViewings", fields: [buyer_id], references: [id], onDelete: Cascade)
  agent         User           @relation("AgentViewings", fields: [agent_id], references: [id], onDelete: Cascade)
  location_pings LocationPing[]

  @@map("viewings")
}

model LocationPing {
  id          String   @id @default(cuid())
  viewing_id  String
  latitude    Float
  longitude   Float
  recorded_at DateTime @default(now())

  viewing Viewing @relation(fields: [viewing_id], references: [id], onDelete: Cascade)

  @@map("location_pings")
}
